
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#071225">
<title>CinemaTOM</title>

<style>
:root {
  --bg: #071225;
  --panel: #101e36;
  --blue: #3985f6;
  --blue-light: #78b1ff;
  --text: #f4f7ff;
  --muted: #9aacc8;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(ellipse at top, #193969 0%, transparent 48%), var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

header {
  padding: 22px 18px;
  background: rgba(5, 15, 32, .94);
  border-bottom: 1px solid rgba(120, 177, 255, .18);
  position: sticky;
  top: 0;
  z-index: 5;
  backdrop-filter: blur(14px);
}

.header-inner {
  max-width: 1200px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.logo {
  margin: 0;
  font-size: 27px;
  letter-spacing: 1px;
  font-weight: 900;
}

.logo span {
  color: var(--blue-light);
}

.online {
  font-size: 12px;
  color: #8fe0b2;
  background: rgba(55, 190, 120, .12);
  border: 1px solid rgba(100, 220, 160, .25);
  border-radius: 20px;
  padding: 8px 12px;
}

main {
  max-width: 1200px;
  margin: auto;
  padding: 24px 18px 45px;
}

.hero {
  padding: 22px 0 25px;
}

.hero h2 {
  font-size: clamp(27px, 5vw, 42px);
  margin: 0 0 12px;
}

.hero p {
  color: var(--muted);
  line-height: 1.6;
  margin: 0;
  max-width: 650px;
}

.search {
  width: 100%;
  margin: 12px 0 25px;
  padding: 15px 17px;
  background: var(--panel);
  border: 1px solid #293c5c;
  border-radius: 12px;
  color: white;
  font-size: 16px;
  outline: none;
}

.search:focus {
  border-color: var(--blue);
}

.section-title {
  margin: 10px 0 18px;
  font-size: 21px;
}

.movies {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
  gap: 20px;
}

.movie {
  background: linear-gradient(160deg, #152744, #0d192e);
  border: 1px solid rgba(150, 180, 230, .14);
  border-radius: 16px;
  overflow: hidden;
  transition: transform .2s, border-color .2s;
}

.movie:hover {
  transform: translateY(-3px);
  border-color: rgba(100, 160, 255, .65);
}

.poster {
  height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 15px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #174f91, #101b40 70%);
}

.poster::before {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  border: 1px solid rgba(255, 255, 255, .12);
  border-radius: 50%;
  box-shadow: 0 0 0 25px rgba(255,255,255,.025),
              0 0 0 50px rgba(255,255,255,.025);
}

.symbol {
  z-index: 1;
  font-size: 42px;
  margin-bottom: 12px;
}

.poster-title {
  position: relative;
  z-index: 1;
  font-size: 17px;
  line-height: 1.2;
  font-weight: 900;
  text-transform: uppercase;
  text-shadow: 0 2px 9px #000;
}

.tag {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 5px 8px;
  border-radius: 6px;
  background: rgba(4, 12, 26, .75);
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 1px;
}

.sponge {
  background: linear-gradient(145deg, #c18b16, #255e9b 75%);
}

.land {
  background: linear-gradient(145deg, #2a9b9e, #153b76 70%);
}

.furioza {
  background: linear-gradient(145deg, #8c272d, #171b2b 75%);
}

.pirate {
  background: linear-gradient(145deg, #8b5529, #152a50 75%);
}

.plankton {
  background: linear-gradient(145deg, #247e65, #151e48 75%);
}

.movie-info {
  padding: 14px;
}

.movie h3 {
  font-size: 15px;
  line-height: 1.4;
  min-height: 42px;
  margin: 0 0 7px;
}

.movie-info p {
  color: var(--muted);
  font-size: 12px;
  margin: 0 0 14px;
}

.play {
  display: block;
  width: 100%;
  border: 0;
  border-radius: 9px;
  background: linear-gradient(135deg, #438ef8, #2864d8);
  color: white;
  padding: 12px 8px;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  text-decoration: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.play:active {
  transform: scale(.98);
}

.empty {
  display: none;
  color: var(--muted);
  padding: 25px 0;
}

footer {
  text-align: center;
  padding: 25px 15px;
  color: #7e91b0;
  border-top: 1px solid rgba(120, 177, 255, .12);
  font-size: 12px;
}

@media (max-width: 420px) {
  main {
    padding-left: 14px;
    padding-right: 14px;
  }

  .movies {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .poster {
    height: 190px;
  }

  .movie-info {
    padding: 10px;
  }

  .logo {
    font-size: 23px;
  }
}
</style>
</head>

